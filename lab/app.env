# Datos de la app para lab/app.sh, los workflows y el verificador.
APP_NOMBRE="Damn Vulnerable GraphQL Application"
APP_PUERTO=5013
# GET / sirve la página principal y responde 200 aun con la base recién creada.
APP_RUTA_SALUD="/"
APP_RUTA_INICIAL=""
# El Dockerfile fija WEB_HOST=127.0.0.1 por config.py; dentro del contenedor eso no es
# alcanzable desde afuera. WEB_HOST=0.0.0.0 publica la app en el puerto mapeado.
# setup.py reconstruye la base SQLite en cada arranque (lo llama app.py), así que no hay
# ruta de inicialización que llamar.
APP_DOCKER_ARGS=(-e WEB_HOST=0.0.0.0)
APP_COMANDO=()
APP_IMAGEN_UPSTREAM=""
APP_ESPERA_SEGUNDOS=120
# ZAP en modo GraphQL: importa el esquema por introspección desde el endpoint y hace
# análisis activo. zap-api-scan.py -f graphql -t http://localhost:$APP_PUERTO$ZAP_GRAPHQL
ZAP_MODO="graphql"
ZAP_OPENAPI=""
ZAP_GRAPHQL="/graphql"
